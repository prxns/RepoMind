APP_ENV=development
DATABASE_URL=postgresql+psycopg://repomind:repomind@localhost:5432/repomind
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1/interactions
GEMINI_PRIMARY_MODEL=gemini-3.8-flash
GEMINI_SECONDARY_MODEL=gemini-3.7-flash
GEMINI_TIMEOUT_SECONDS=45
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
RERANKER_PROVIDER=token_overlap
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=30
GLOBAL_RATE_LIMIT_PER_MINUTE=120
MAX_ACTIVE_INGESTIONS=8
MAX_CONCURRENT_QUERIES=4
MAX_FILES=5000
MAX_FILE_BYTES=524288
MAX_TOTAL_BYTES=26214400
MAX_CHUNKS=25000
EVIDENCE_GATE_MIN_SCORE=0.30
EVIDENCE_GATE_MIN_SIGNALS=2
EVIDENCE_GATE_MIN_QUERY_TERMS=1
EVIDENCE_GATE_MIN_LEXICAL_COVERAGE=0.20
EVIDENCE_GATE_MIN_DENSE_SIMILARITY=0.25
EVIDENCE_GATE_MIN_RANK_AGREEMENT=0.20
EVIDENCE_GATE_MIN_RERANKER_OVERLAP=0.20
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
